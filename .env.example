# Copy to .env only as a personal reference; this project does not auto-load it.
ANPR_CAMERA_INDEX=0
ANPR_DATABASE_PATH=data/vehicles.example.csv
ANPR_OCR_EVERY_N=30
ANPR_OCR_CONFIDENCE_THRESHOLD=0.5
ANPR_MATCHING_POLICY=exact
# Used only when ANPR_MATCHING_POLICY=fuzzy (experimental).
ANPR_MATCH_TOLERANCE=1
ANPR_SCREENSHOT_DIR=screenshots
ANPR_COOLDOWN_SECONDS=3
ANPR_MIN_OCR_LENGTH=3

# Flask web demo. Leave blank to use the operating system temporary directory.
ANPR_WEB_TEMP_DIR=
# easyocr for local/Raspberry Pi development; tesseract for lightweight hosting.
ANPR_WEB_OCR_BACKEND=easyocr
# SQLite is used only by Flask; the Raspberry Pi CLI continues using the CSV above.
ANPR_SQLITE_PATH=data/anpr_web.sqlite3
# Store timestamps in UTC and display them in this IANA timezone.
ANPR_TIMEZONE=Asia/Tokyo
# entry, exit, or selectable (the operator chooses before each web analysis).
ANPR_CHECKPOINT_MODE=entry
# Generate a long random value; never reuse this example comment as a secret.
ANPR_SECRET_KEY=
ANPR_ADMIN_USERNAME=
# Generate with Werkzeug; never place a plaintext password here.
ANPR_ADMIN_PASSWORD_HASH=

# Optional parking summary. Leave blank to show occupancy without availability.
ANPR_PARKING_CAPACITY=
ANPR_APPLICATION_NAME=Example Campus Parking

# Exit-summary email is safely disabled by default.
ANPR_EMAIL_ENABLED=false
# smtp, http-api, or dry-run. Render Free should use http-api over HTTPS.
ANPR_EMAIL_BACKEND=smtp
ANPR_EMAIL_API_KEY=
ANPR_EMAIL_API_URL=
ANPR_SMTP_HOST=
ANPR_SMTP_PORT=587
ANPR_SMTP_USERNAME=
ANPR_SMTP_PASSWORD=
ANPR_SMTP_USE_TLS=true
ANPR_EMAIL_FROM=
ANPR_EMAIL_FROM_NAME=Example Campus Parking
ANPR_EMAIL_TIMEOUT_SECONDS=5
