# Copy to .env only as a personal reference; this project does not auto-load it.
ANPR_CAMERA_INDEX=0
ANPR_DATABASE_PATH=data/vehicles.example.csv
ANPR_OCR_EVERY_N=30
ANPR_OCR_CONFIDENCE_THRESHOLD=0.5
ANPR_MATCHING_POLICY=exact
# Used only when ANPR_MATCHING_POLICY=fuzzy (experimental).
ANPR_MATCH_TOLERANCE=1
ANPR_SCREENSHOT_DIR=screenshots
ANPR_COOLDOWN_SECONDS=3
ANPR_MIN_OCR_LENGTH=3
